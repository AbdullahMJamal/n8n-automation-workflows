        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "524bebf9-ec31-4000-9acf-6ce14053892e",
                    "leftValue": "={{ $json.confidence_score }}",
                    "rightValue": "={{ $('Config').first().json.confidence_threshold }}",
